package pzformat;

import java.util.List;
import java.util.Random;

/**
 * Structured tree placement modelled on succession.
 *
 * Distance from the nearest building or road is a decent proxy for how long
 * ground has gone undisturbed, and that is what actually drives what grows
 * there. Close in you get planted ornamentals kept small; further out,
 * regrowth; further still, mature closed canopy where conifers take over.
 * The BFS distance field was already being computed for density, so driving
 * size class and species mix from it as well costs nothing.
 *
 * Bands, by distance in tiles from any building or road square:
 *
 *   0 .. CLEAR   nothing. Yards and road verges stay open.
 *   .. 9         size 2-3, ornamental only. Planted, small, varied.
 *   .. 22        size 4-5, half ornamental half hardwood. Regrowth.
 *   .. 45        size 6-7, mostly hardwood with conifer appearing.
 *   beyond       size 7-8, conifer-dominant. Old growth.
 *
 * Species coherence: woodland species are chosen per jittered Voronoi region
 * rather than per tile, so stands hold together and have irregular edges. The
 * roadside band deliberately does NOT do this — planted trees vary tree by
 * tree, which is what makes that band read as deliberate rather than natural.
 *
 * Stumps are scattered thinly everywhere beyond the clear band. A stump is a
 * tree that was there and isn't.
 *
 * A minimum spacing stops trunks overlapping; jumbo sprites run to 192x256.
 *
 * Deterministic for a given seed, so a render diff between runs shows real
 * changes rather than reshuffled noise.
 */
public final class TreeScatter {

    public static final int CLEAR = 3;

    /** Minimum tiles between trunks. */
    public static final int SPACING = 2;

    /** Rough tiles between species-region seed points. Larger = bigger stands. */
    public static final int CLUMP = 60;

    /** Chance per eligible square of a stump instead of a tree. */
    public static final double P_STUMP = 0.0010;

    /**
     * A succession band. Weights need not sum to 1; they are normalised.
     */
    record Band(int maxDist, int sizeMin, int sizeMax,
                double ornamental, double hardwood, double conifer,
                double density, boolean clumped, String label) { }

    static final Band[] BANDS = {
            new Band(9,  2, 3, 1.00, 0.00, 0.00, 0.020, false, "roadside"),
            new Band(22, 4, 5, 0.50, 0.50, 0.00, 0.035, true,  "regrowth"),
            new Band(45, 6, 7, 0.15, 0.60, 0.25, 0.070, true,  "woodland"),
            new Band(Integer.MAX_VALUE, 7, 8, 0.00, 0.45, 0.55, 0.080, true, "old growth"),
    };

    /**
     * @return tile name per raster square, or null where nothing goes.
     */
    public static String[][] place(GisImport g, TreePalette tp, long seed) {
        int w = g.width, h = g.height;
        String[][] out = new String[w][h];

        if (!tp.usable()) {
            System.out.println("trees: no usable tree tiles; skipping scatter");
            return out;
        }

        List<String> orn = tp.available(TreePalette.ORNAMENTAL);
        List<String> hard = tp.available(TreePalette.HARDWOOD);
        List<String> conif = tp.available(TreePalette.CONIFER);

        int[][] dist = distanceToStructure(g);
        Random rng = new Random(seed);
        boolean[][] taken = new boolean[w][h];
        Clumps clumps = new Clumps(w, h, seed);

        long[] perBand = new long[BANDS.length];
        long stumps = 0;

        for (int x = 0; x < w; x++) {
            for (int y = 0; y < h; y++) {
                if (isStructure(g, x, y)) {
                    continue;
                }
                int d = dist[x][y];
                if (d <= CLEAR) {
                    continue;
                }

                int bi = bandFor(d);
                Band band = BANDS[bi];

                // A stump is a tree that used to be here, so it competes for
                // the same square and respects the same spacing.
                if (tp.hasStump && rng.nextDouble() < P_STUMP) {
                    if (!tooClose(taken, x, y, w, h)) {
                        out[x][y] = TreePalette.STUMP;
                        taken[x][y] = true;
                        stumps++;
                    }
                    continue;
                }

                if (rng.nextDouble() >= band.density()) {
                    continue;
                }
                if (tooClose(taken, x, y, w, h)) {
                    continue;
                }

                double catRoll, spRoll;
                if (band.clumped()) {
                    catRoll = clumps.categoryRoll(x, y);
                    spRoll = clumps.speciesRoll(x, y);
                } else {
                    catRoll = rng.nextDouble();
                    spRoll = rng.nextDouble();
                }

                List<String> pool = choosePool(band, catRoll, orn, hard, conif);
                if (pool == null || pool.isEmpty()) {
                    continue;
                }
                String species = pool.get(Math.min(pool.size() - 1,
                        (int) (spRoll * pool.size())));

                int size = band.sizeMin() + rng.nextInt(band.sizeMax() - band.sizeMin() + 1);
                List<String> variants = tp.tilesNear(species, size);
                if (variants == null || variants.isEmpty()) {
                    continue;
                }

                out[x][y] = variants.get(rng.nextInt(variants.size()));
                taken[x][y] = true;
                perBand[bi]++;
            }
        }

        long total = 0;
        for (long n : perBand) {
            total += n;
        }
        System.out.println("trees: " + total + " placed, " + stumps + " stumps");
        for (int i = 0; i < BANDS.length; i++) {
            System.out.printf("   %-11s size %d-%d  %6d%n",
                    BANDS[i].label(), BANDS[i].sizeMin(), BANDS[i].sizeMax(), perBand[i]);
        }
        return out;
    }

    static int bandFor(int d) {
        for (int i = 0; i < BANDS.length; i++) {
            if (d <= BANDS[i].maxDist()) {
                return i;
            }
        }
        return BANDS.length - 1;
    }

    /** Weighted pick between the three species groups, skipping empty ones. */
    static List<String> choosePool(Band b, double roll,
                                   List<String> orn, List<String> hard, List<String> conif) {
        double wo = orn.isEmpty() ? 0 : b.ornamental();
        double wh = hard.isEmpty() ? 0 : b.hardwood();
        double wc = conif.isEmpty() ? 0 : b.conifer();
        double sum = wo + wh + wc;
        if (sum <= 0) {
            if (!hard.isEmpty()) return hard;
            if (!conif.isEmpty()) return conif;
            return orn.isEmpty() ? null : orn;
        }
        double r = roll * sum;
        if (r < wo) return orn;
        if (r < wo + wh) return hard;
        return conif;
    }

    /**
     * Jittered Voronoi regions carrying two stable random values each: one for
     * the species group, one for the species within it.
     *
     * Seeds sit on a coarse grid but are randomly offset within their cell, so
     * region boundaries are irregular. Nearest-seed lookup only checks the 3x3
     * neighbourhood, since no seed two cells away can be nearer.
     */
    static final class Clumps {
        final int cols, rows;
        final int[][] sx, sy;
        final double[][] cat, sp;

        Clumps(int w, int h, long seed) {
            cols = w / CLUMP + 2;
            rows = h / CLUMP + 2;
            sx = new int[cols][rows];
            sy = new int[cols][rows];
            cat = new double[cols][rows];
            sp = new double[cols][rows];
            Random r = new Random(seed ^ 0x5EED1EL);
            for (int i = 0; i < cols; i++) {
                for (int j = 0; j < rows; j++) {
                    sx[i][j] = i * CLUMP + r.nextInt(CLUMP);
                    sy[i][j] = j * CLUMP + r.nextInt(CLUMP);
                    cat[i][j] = r.nextDouble();
                    sp[i][j] = r.nextDouble();
                }
            }
        }

        private int[] nearest(int x, int y) {
            int gx = x / CLUMP, gy = y / CLUMP;
            long best = Long.MAX_VALUE;
            int bi = 0, bj = 0;
            for (int i = Math.max(0, gx - 1); i <= Math.min(cols - 1, gx + 1); i++) {
                for (int j = Math.max(0, gy - 1); j <= Math.min(rows - 1, gy + 1); j++) {
                    long dx = x - sx[i][j], dy = y - sy[i][j];
                    long d = dx * dx + dy * dy;
                    if (d < best) {
                        best = d;
                        bi = i;
                        bj = j;
                    }
                }
            }
            return new int[]{bi, bj};
        }

        double categoryRoll(int x, int y) {
            int[] c = nearest(x, y);
            return cat[c[0]][c[1]];
        }

        double speciesRoll(int x, int y) {
            int[] c = nearest(x, y);
            return sp[c[0]][c[1]];
        }
    }

    /**
     * BFS distance from every building or road square. Squares that ARE
     * structure get 0, so bands measure outward from them.
     */
    static int[][] distanceToStructure(GisImport g) {
        int w = g.width, h = g.height;
        int[][] dist = new int[w][h];
        int[] queue = new int[w * h];
        int head = 0, tail = 0;

        for (int x = 0; x < w; x++) {
            for (int y = 0; y < h; y++) {
                if (isStructure(g, x, y)) {
                    dist[x][y] = 0;
                    queue[tail++] = x * h + y;
                } else {
                    dist[x][y] = Integer.MAX_VALUE;
                }
            }
        }

        // No structure anywhere: everything is old growth.
        if (tail == 0) {
            return dist;
        }

        final int[] dx = {1, -1, 0, 0};
        final int[] dy = {0, 0, 1, -1};
        while (head < tail) {
            int cur = queue[head++];
            int x = cur / h, y = cur % h;
            int nd = dist[x][y] + 1;
            for (int k = 0; k < 4; k++) {
                int nx = x + dx[k], ny = y + dy[k];
                if (nx < 0 || ny < 0 || nx >= w || ny >= h) {
                    continue;
                }
                if (dist[nx][ny] > nd) {
                    dist[nx][ny] = nd;
                    queue[tail++] = nx * h + ny;
                }
            }
        }
        return dist;
    }

    /** Building, road, or a derived wall — anything trees must keep off. */
    static boolean isStructure(GisImport g, int x, int y) {
        return g.cover[x][y] == GisImport.Cover.BUILDING
                || g.cover[x][y] == GisImport.Cover.ROAD
                || g.northWall[x][y] || g.westWall[x][y];
    }

    static boolean tooClose(boolean[][] taken, int x, int y, int w, int h) {
        int x0 = Math.max(0, x - SPACING), x1 = Math.min(w - 1, x + SPACING);
        int y0 = Math.max(0, y - SPACING), y1 = Math.min(h - 1, y + SPACING);
        for (int i = x0; i <= x1; i++) {
            for (int j = y0; j <= y1; j++) {
                if (taken[i][j]) {
                    return true;
                }
            }
        }
        return false;
    }
}
