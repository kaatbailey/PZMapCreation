package pzformat;

import java.util.ArrayList;
import java.util.List;
import java.util.Map;
import java.util.Set;
import java.util.TreeMap;

/**
 * Tree tiles indexed by species and size class.
 *
 * The `tree` property is a size class 1-8, matching the WorldGen feature files
 * in media/lua/server/WorldGen/features/tree/: sapling, plain, jumbo,
 * jumbo_xl, jumbo_xxl. All 11 species carry all 8 classes with full sprite
 * coverage.
 *
 * Size is NOT derivable from the tileset name — classes 1-4 all share
 * e_<species>_1 and classes 5-6 share e_<species>JUMBO_1. Only 7 (JUMBOXL)
 * and 8 (JUMBOXXL) get their own tilesets. So the property is the source of
 * truth and the name is only good for species.
 *
 * Species names differ between the two places they appear: the feature Lua
 * uses short forms (maple, birch, holly) while tiledefs use full common names
 * (redmaple, riverbirch, americanholly), so matching is by substring.
 *
 * Species are grouped by how they actually grow, which is what lets density
 * bands vary the mix with distance from habitation:
 *
 *   ORNAMENTAL  small flowering and understory trees — what gets planted
 *   HARDWOOD    deciduous canopy
 *   CONIFER     pine and hemlock, which dominate undisturbed ground
 *
 * These tiles only became selectable once the legacy .pack layout parsed:
 * JumboTrees1x.pack and JumboTrees2x.pack are both legacy, so before that
 * every tree in the game looked like it had no sprite.
 */
public final class TreePalette {

    /** A felled tree. One tile, from WorldGen's stumps feature. */
    public static final String STUMP = "crafted_02_86";

    public static final List<String> ORNAMENTAL =
            List.of("dogwood", "redbud", "silverbell", "hawthorn", "holly");
    public static final List<String> HARDWOOD =
            List.of("maple", "linden", "yellowwood", "birch");
    public static final List<String> CONIFER =
            List.of("pine", "hemlock");

    static final List<String> ALL_SPECIES = new ArrayList<>();
    static {
        ALL_SPECIES.addAll(ORNAMENTAL);
        ALL_SPECIES.addAll(HARDWOOD);
        ALL_SPECIES.addAll(CONIFER);
    }

    /** species -> size class -> usable tile names. */
    private final Map<String, Map<Integer, List<String>>> tiles = new TreeMap<>();

    /** Every tile name chosen, so the cell header can declare them. */
    public final List<String> all = new ArrayList<>();

    public boolean hasStump;

    public static TreePalette pick(TileIndex ti, Set<String> sprites) {
        TreePalette p = new TreePalette();

        for (String n : ti.byName.keySet()) {
            TileDefs.Tile t = ti.get(n);
            if (t == null) {
                continue;
            }
            String v = t.props.get("tree");
            if (v == null || v.isEmpty()) {
                continue;
            }
            if (!sprites.contains(n)) {
                continue;
            }
            if (ti.kindOf(n) != TileIndex.Kind.VEGETATION) {
                continue;
            }
            int size;
            try {
                size = Integer.parseInt(v.trim());
            } catch (NumberFormatException e) {
                continue;
            }
            String species = speciesOf(t.tileset);
            if (species == null) {
                continue;
            }
            p.tiles.computeIfAbsent(species, k -> new TreeMap<>())
                    .computeIfAbsent(size, k -> new ArrayList<>())
                    .add(n);
            p.all.add(n);
        }

        if (sprites.contains(STUMP)) {
            p.hasStump = true;
            p.all.add(STUMP);
        }
        return p;
    }

    /** Substring match: e_redmapleJUMBO_1 -> maple, e_riverbirchJUMBO_1 -> birch. */
    static String speciesOf(String tileset) {
        String low = tileset.toLowerCase();
        for (String s : ALL_SPECIES) {
            if (low.contains(s)) {
                return s;
            }
        }
        return null;
    }

    /**
     * Tiles for a species at a size class, falling back to the nearest
     * available class. Species coverage is complete in 42.20, but a fallback
     * costs nothing and stops a missing class from silently dropping trees.
     */
    public List<String> tilesNear(String species, int size) {
        Map<Integer, List<String>> bySize = tiles.get(species);
        if (bySize == null || bySize.isEmpty()) {
            return null;
        }
        List<String> exact = bySize.get(size);
        if (exact != null && !exact.isEmpty()) {
            return exact;
        }
        for (int d = 1; d <= 8; d++) {
            List<String> lo = bySize.get(size - d);
            if (lo != null && !lo.isEmpty()) {
                return lo;
            }
            List<String> hi = bySize.get(size + d);
            if (hi != null && !hi.isEmpty()) {
                return hi;
            }
        }
        return null;
    }

    /** Members of a group that actually have usable art. */
    public List<String> available(List<String> group) {
        List<String> out = new ArrayList<>();
        for (String s : group) {
            Map<Integer, List<String>> m = tiles.get(s);
            if (m != null && !m.isEmpty()) {
                out.add(s);
            }
        }
        return out;
    }

    public boolean usable() {
        return !tiles.isEmpty();
    }

    @Override public String toString() {
        int total = 0;
        for (Map<Integer, List<String>> m : tiles.values()) {
            for (List<String> l : m.values()) {
                total += l.size();
            }
        }
        return tiles.size() + " species, " + total + " tiles"
                + " (ornamental " + available(ORNAMENTAL).size()
                + ", hardwood " + available(HARDWOOD).size()
                + ", conifer " + available(CONIFER).size() + ")"
                + (hasStump ? ", stumps available" : ", NO stump tile");
    }
}
